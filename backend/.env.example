# Optional local configuration. SQLite works without this file.
DB_DIALECT=sqlite
DB_STORAGE=./dev.sqlite
UPLOAD_DIR=./uploads
PORT=5000

# Development-only seed account. Change these before sharing a deployment.
SEED_ADMIN_EMAIL=admin@fundwatch.local
SEED_ADMIN_PASSWORD=Admin@12345

# Replace with a unique random value outside local development.
JWT_SECRET=replace-with-a-unique-random-secret